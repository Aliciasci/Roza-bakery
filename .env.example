# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemple-roza-bakery.fr

# Envoi d'emails (optionnel) — https://resend.com
# Sans clé, les notifications sont simplement affichées dans la console serveur.
RESEND_API_KEY=
# Adresse expéditrice vérifiée chez Resend
EMAIL_FROM="Roza Bakery <commandes@exemple.fr>"
# Adresse qui reçoit les nouvelles demandes
BAKERY_NOTIFICATION_EMAIL=

# Administration (/admin) — mot de passe d'accès (obligatoire pour activer l'admin)
ADMIN_PASSWORD=
# Facultatif : secret de signature des sessions (sinon dérivé du mot de passe)
ADMIN_SECRET=

# Dossier des données persistantes (commandes, photos, contenu de l'admin).
# En local : laisser vide (→ ./data). Sur Railway : /data (chemin du volume).
DATA_DIR=
